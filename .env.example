# Local LM Studio OpenAI-compatible endpoint
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen/qwen3-8b

# Optional workspace override. Leave blank to use this repository.
RIKU_WORKSPACE_ROOT=

# Local LibSQL storage for Studio memory and workflow state.
MASTRA_DATABASE_URL=file:./architect.db
MASTRA_TELEMETRY_DISABLED=1

# Custom MedSpec AI frontend
MEDSPEC_HOST=127.0.0.1
MEDSPEC_PORT=4173
